    def get_form_values(self):

        return {
            key: widget.get().strip()
            for key, widget
            in self.entries.items()
        }

    def validate_form(self, data):

        required = [
            "product_name",
            "category",
            "quantity",
            "price",
            "supplier",
            "phone",
            "email"
        ]

        for field in required:

            if not data[field]:

                messagebox.showwarning(
                    "Validation",
                    "Please fill all fields."
                )

                return False

        if not valid_number(
            data["quantity"]
        ):

            messagebox.showwarning(
                "Validation",
                "Quantity must be a whole number."
            )

            return False

        if not valid_price(
            data["price"]
        ):

            messagebox.showwarning(
                "Validation",
                "Price must be a valid number."
            )

            return False

        if not valid_phone(
            data["phone"]
        ):

            messagebox.showwarning(
                "Validation",
                "Phone number must contain exactly 10 digits."
            )

            return False

        if not valid_email(
            data["email"]
        ):

            messagebox.showwarning(
                "Validation",
                "Please enter a valid email."
            )

            return False

        return True

  

