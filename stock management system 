    def load_records(self):

        for item in self.tree.get_children():

            self.tree.delete(item)

        conn = None
        cursor = None

        try:

            conn = get_db_connection()
            cursor = conn.cursor()

            # SELECT
            cursor.execute("""
                SELECT
                    id,
                    product_name,
                    category,
                    quantity,
                    price,
                    supplier,
                    phone,
                    email
                FROM stocks
                ORDER BY id DESC
            """)

            rows = cursor.fetchall()

            for row in rows:

                row = list(row)

                row[4] = f"{float(row[4]):.2f}"

                self.tree.insert(
                    "",
                    tk.END,
                    values=row
                )

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

   

