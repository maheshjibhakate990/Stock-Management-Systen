    def load_search_records(
        self,
        search_text=""
    ):

        for item in self.search_tree.get_children():

            self.search_tree.delete(item)

        conn = None
        cursor = None

        try:

            conn = get_db_connection()
            cursor = conn.cursor()

            if not search_text:

                cursor.execute("""
                    SELECT
                        id,
                        product_name,
                        category,
                        quantity,
                        price,
                        supplier,
                        phone,
                        email
                    FROM stocks
                    ORDER BY id DESC
                """)

            else:

                field_map = {
                    "Product Name": "product_name",
                    "Category": "category",
                    "Supplier": "supplier",
                    "Phone": "phone",
                    "Email": "email"
                }

                field = field_map[
                    self.search_field.get()
                ]

                
                query = f"""
                    SELECT
                        id,
                        product_name,
                        category,
                        quantity,
                        price,
                        supplier,
                        phone,
                        email
                    FROM stocks
                    WHERE {field} LIKE %s
                    ORDER BY id DESC
                """

                cursor.execute(
                    query,
                    (f"%{search_text}%",)
                )

            rows = cursor.fetchall()

            for row in rows:

                row = list(row)

                row[4] = f"{float(row[4]):.2f}"

                self.search_tree.insert(
                    "",
                    tk.END,
                    values=row
                )

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

    def perform_search(self):

        text = self.search_entry.get().strip()

        if not text:

            messagebox.showwarning(
                "Search",
                "Please enter something to search."
            )

            return

        self.load_search_records(
            text
        )

    def reset_search(self):

        self.search_entry.delete(
            0,
            tk.END
        )

        self.search_field.set(
            "Product Name"
        )

        self.load_search_records()

   
