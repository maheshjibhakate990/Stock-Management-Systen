        values = self.tree.item(
            selected[0],
            "values"
        )

        self.selected_id = values[0]

        self.show_update_form(values)

    def show_update_form(self, values):

        self.create_form_page(
            "Update Stock Record",
            "Update Record",
            self.update_record
        )

        data = [
            ("product_name", values[1]),
            ("category", values[2]),
            ("quantity", values[3]),
            ("price", values[4]),
            ("supplier", values[5]),
            ("phone", values[6]),
            ("email", values[7])
        ]

        for key, value in data:

            widget = self.entries[key]

            if isinstance(
                widget,
                ttk.Combobox
            ):

                widget.set(value)

            else:

                widget.insert(
                    0,
                    value
                )

    def update_record(self):

        if not self.selected_id:

            messagebox.showwarning(
                "Update",
                "No record selected."
            )

            return

        data = self.get_form_values()

        if not self.validate_form(data):
            return

        conn = None
        cursor = None

        try:

            conn = get_db_connection()
            cursor = conn.cursor()

           
            cursor.execute("""
                UPDATE stocks
                SET
                    product_name=%s,
                    category=%s,
                    quantity=%s,
                    price=%s,
                    supplier=%s,
                    phone=%s,
                    email=%s
                WHERE id=%s
            """, (
                data["product_name"],
                data["category"],
                int(data["quantity"]),
                float(data["price"]),
                data["supplier"],
                data["phone"],
                data["email"],
                self.selected_id
            ))

            conn.commit()

