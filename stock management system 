    def get_stats(self):

        conn = None
        cursor = None

        try:

            conn = get_db_connection()
            cursor = conn.cursor()

            cursor.execute("""
                SELECT
                    COUNT(*),
                    COALESCE(SUM(quantity), 0),
                    COALESCE(SUM(quantity * price), 0)
                FROM stocks
            """)

            row = cursor.fetchone()

            return (
                int(row[0]),
                int(row[1]),
                float(row[2])
            )

        except Error:

            return 0, 0, 0

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

