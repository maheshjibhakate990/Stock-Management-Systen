    def add_record(self):

        data = self.get_form_values()

        if not self.validate_form(data):
            return

        conn = None
        cursor = None

        try:

            conn = get_db_connection()
            cursor = conn.cursor()

           
            cursor.execute("""
                INSERT INTO stocks
                (
                    product_name,
                    category,
                    quantity,
                    price,
                    supplier,
                    phone,
                    email
                )
                VALUES
                (%s, %s, %s, %s, %s, %s, %s)
            """, (
                data["product_name"],
                data["category"],
                int(data["quantity"]),
                float(data["price"]),
                data["supplier"],
                data["phone"],
                data["email"]
            ))

            conn.commit()

            messagebox.showinfo(
                "Success",
                "Stock record added successfully."
            )

            self.clear_form()

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

   

