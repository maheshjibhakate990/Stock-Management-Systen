            )

            self.show_view()

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

   
    def delete_selected(self):

        selected = self.tree.selection()

        if not selected:

            messagebox.showwarning(
                "Delete",
                "Please select a record."
            )

            return

        values = self.tree.item(
            selected[0],
            "values"
        )

        record_id = values[0]
        product_name = values[1]

        confirm = messagebox.askyesno(
            "Confirm Delete",
            f"Are you sure you want to delete "
            f"'{product_name}'?"
        )

        if not confirm:
            return

        conn = None
        cursor = None

        try:

            conn = get_db_connection()
            cursor = conn.cursor()

            
            cursor.execute(
                "DELETE FROM stocks WHERE id=%s",
                (record_id,)
            )

            conn.commit()

            messagebox.showinfo(
                "Deleted",
                "Record deleted successfully."
            )

            self.load_records()

        except Error as e:

            messagebox.showerror(
                "Database Error",
                str(e)
            )

        finally:

            if cursor:
                cursor.close()

            if conn:
                conn.close()

   
